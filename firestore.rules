rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Production dashboard collections
    match /production_analytics/{document} {
      allow read, write: if true;
    }
    match /absenteeism/{document} {
      allow read, write: if true;
    }
    match /logistics_data/{document} {
      allow read, write: if true;
    }
    match /announcements/{document} {
      allow read, write: if true;
    }
    match /user_performance/{document} {
      allow read, write: if true;
    }
    match /ai_knowledge_base/{document} {
      allow read, write: if true;
    }
    match /productivity_reports/{document} {
      allow read, write: if true;
    }
    match /productivity_reports/{document}/chunks/{chunk} {
      allow read, write: if true;
    }
    match /sheets_config/{document} {
      allow read, write: if true;
    }
    match /route_stats/{document} {
      allow read, write: if true;
    }
    match /config/{document} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
