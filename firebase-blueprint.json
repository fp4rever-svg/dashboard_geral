{
  "entities": {
    "LogisticsData": {
      "title": "Logistics Data",
      "description": "Data representing logistics routes and volumes.",
      "type": "object",
      "properties": {
        "rotas": { "type": "string" },
        "totalVolume": { "type": "number" },
        "totalQtdRemessa": { "type": "number" },
        "retVol": { "type": "string" },
        "retUnid": { "type": "string" },
        "horarios": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["rotas", "totalVolume", "totalQtdRemessa", "horarios"]
    },
    "AbsenteeismData": {
      "title": "Absenteeism Data",
      "description": "Data representing employee absences per sector.",
      "type": "object",
      "properties": {
        "setor": { "type": "string" },
        "faltas": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["setor", "faltas", "total"]
    },
    "ProductionAnalytics": {
      "title": "Production Analytics",
      "description": "Hourly production performance data.",
      "type": "object",
      "properties": {
        "hora": { "type": "string" },
        "cubagem": { "type": "string" },
        "separaACS": { "type": "string" },
        "separaUND": { "type": "string" },
        "cFrac": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["hora", "cubagem", "separaACS", "separaUND", "cFrac"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Operational alerts and announcements.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning", "error", "success"] },
        "timestamp": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["title", "content", "type", "timestamp", "active"]
    },
    "UserPerformance": {
      "title": "User Performance",
      "description": "Daily performance by work user/operator.",
      "type": "object",
      "properties": {
        "user": { "type": "string" },
        "recordsUPM": { "type": "number" },
        "conferredQty": { "type": "number" },
        "prodPct": { "type": "string" },
        "upmPct": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["user", "recordsUPM", "conferredQty", "prodPct", "upmPct"]
    },
    "AiDocument": {
      "title": "AI Document",
      "description": "A document uploaded to the operations knowledge base.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "content", "category", "createdAt"]
    },
    "ProductivityReport": {
      "title": "Productivity Report",
      "description": "Consolidated productivity report for conference (conferencia) or separation (separacao).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "headers": { "type": "array" },
        "keyMap": { "type": "object" },
        "normalizedRows": { "type": "array" },
        "rowCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "headers", "keyMap", "normalizedRows", "rowCount", "updatedAt"]
    },
    "SheetsConfig": {
      "title": "Sheets Sync Config",
      "description": "Configuration metadata for Google Sheets synchronization.",
      "type": "object",
      "properties": {
        "spreadsheetId": { "type": "string" },
        "sheetName": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["spreadsheetId", "sheetName", "updatedAt"]
    }
  },
  "firestore": {
    "user_performance": {
      "schema": "UserPerformance",
      "description": "Top performance lists for operators."
    },
    "logistics": {
      "schema": "LogisticsData",
      "description": "Logistics data uploaded by users."
    },
    "absenteeism": {
      "schema": "AbsenteeismData",
      "description": "Absenteeism records for each sector."
    },
    "production_analytics": {
      "schema": "ProductionAnalytics",
      "description": "Hourly production performance records."
    },
    "announcements": {
      "schema": "Announcement",
      "description": "Operational announcements and alerts."
    },
    "ai_knowledge_base": {
      "schema": "AiDocument",
      "description": "Internal knowledge base documents for logistic operations."
    },
    "productivity_reports": {
      "schema": "ProductivityReport",
      "description": "Conference or separation productivity reports."
    },
    "sheets_config": {
      "schema": "SheetsConfig",
      "description": "Google Sheets synchronization config."
    }
  }
}
